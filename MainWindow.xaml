<Window x:Class="CodexPond.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexPond"
        Title="Codex Pond"
        Width="500" Height="313"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True">
    <Canvas x:Name="SceneCanvas" Width="500" Height="313" SnapsToDevicePixels="True">
        <Image x:Name="ThemeArt"
               Canvas.Left="0" Canvas.Top="0"
               Width="500" Height="313"
               Source="Assets/Themes/theme-fusionce.png"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <local:PondRenderer x:Name="PondArt"
                            Canvas.Left="0" Canvas.Top="0"
                            Width="500" Height="313"
                            IsHitTestVisible="False"
                            RenderOptions.EdgeMode="Aliased"/>

        <Polygon x:Name="PondHitTarget"
                 Points="54,89 430,91 478,171 465,249 410,294 84,294 21,244 23,144"
                 Fill="#00000000"
                 Cursor="Hand"
                 Focusable="True"
                 KeyboardNavigation.TabIndex="0"
                 AutomationProperties.Name="池塘水面"
                 AutomationProperties.HelpText="按 Enter 打开 Codex 任务面板，按空格激起涟漪；鼠标单击水面也会激起涟漪，拖动可移动池塘。"
                 ToolTip="单击水面泛起涟漪；双击池塘打开任务面板；拖动可移动池塘"
                 MouseLeftButtonDown="PondHitTarget_MouseLeftButtonDown"
                 MouseMove="PondHitTarget_MouseMove"
                 MouseLeftButtonUp="PondHitTarget_MouseLeftButtonUp"
                 KeyDown="PondHitTarget_KeyDown"
                 GotKeyboardFocus="PondHitTarget_GotKeyboardFocus"
                 LostKeyboardFocus="PondHitTarget_LostKeyboardFocus"/>
        <Border x:Name="PondFocusRing"
                Canvas.Left="18" Canvas.Top="82"
                Width="466" Height="215"
                BorderBrush="#FFF2C0"
                BorderThickness="2"
                CornerRadius="18"
                Background="Transparent"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
        <Border x:Name="DragHandle"
                Canvas.Left="276" Canvas.Top="15"
                Width="140" Height="18"
                Background="#01000000"
                Cursor="SizeAll"
                ToolTip="拖动移动池塘"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"/>

        <Border x:Name="StatusPanelBorder"
                Canvas.Left="321" Canvas.Top="113"
                Width="142" Height="26"
                Background="#E523453F"
                BorderBrush="#A87948"
                BorderThickness="2"
                IsHitTestVisible="False"/>
        <Border x:Name="FishCountPanelBorder"
                Canvas.Left="189" Canvas.Top="226"
                Width="89" Height="25"
                Background="#E523453F"
                BorderBrush="#A87948"
                BorderThickness="2"
                IsHitTestVisible="False"/>
        <Button x:Name="PondStatusButton"
                Canvas.Left="328" Canvas.Top="117"
                Width="128" Height="21"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                AutomationProperties.Name="打开 Codex 任务面板"
                AutomationProperties.HelpText="查看 Codex 回复和处理待办请求"
                ToolTip="打开 Codex 回复与任务记录"
                Click="PondStatusButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="StatusFocusBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="StatusFocusBorder" Property="BorderBrush" Value="#FFFFE7A8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="PondStatusText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="9.5"
                       FontWeight="SemiBold"
                       Foreground="#FFF0C0"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="池塘任务状态"
                       AutomationProperties.LiveSetting="Polite"
                       Text="夜色垂钓 · 安静中"/>
        </Button>
        <TextBlock x:Name="EnvironmentText"
                   Canvas.Left="333" Canvas.Top="20"
                   Width="128" Height="17"
                   Padding="2,1"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="8.5"
                   FontWeight="SemiBold"
                   Foreground="#FFF1C9"
                   Background="#D523453F"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   IsHitTestVisible="False"/>
        <TextBlock x:Name="PondEventText"
                   Canvas.Left="24" Canvas.Top="20"
                   Width="190" Height="17"
                   Padding="2,1"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="8"
                   FontWeight="SemiBold"
                   Foreground="#FFF1C9"
                   Background="#D5794E36"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <Button x:Name="FishCountButton"
                Canvas.Left="192" Canvas.Top="228"
                Width="83" Height="22"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                AutomationProperties.Name="打开本地鱼册"
                ToolTip="打开本地鱼册"
                Click="FishCountButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="FishCountFocusBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FishCountFocusBorder" Property="BorderBrush" Value="#FFFFE7A8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="FishCountText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="9.5"
                       FontWeight="Bold"
                       Foreground="#FFF0C0"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="本地鱼册条目数"
                       Text="鱼册 · 0"/>
        </Button>

        <Button x:Name="HidePondButton"
                Canvas.Left="462" Canvas.Top="99"
                Width="19" Height="19"
                Padding="0"
                Content="×"
                FontFamily="Microsoft YaHei UI"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#EDC17B"
                Background="#01000000"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                AutomationProperties.Name="隐藏池塘；可从系统托盘重新打开"
                ToolTip="隐藏池塘；可从系统托盘恢复"
                Click="HidePondButton_Click"/>
    </Canvas>
</Window>
