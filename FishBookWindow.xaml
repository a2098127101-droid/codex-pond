<Window x:Class="CodexPond.FishBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鱼册" Width="420" Height="540" MinWidth="360" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        SnapsToDevicePixels="True">
    <Grid Margin="5">
        <Border Background="#211A18" BorderBrush="#805331" BorderThickness="2" Padding="3">
            <Grid Background="#DDC191">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#3B2922" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="池塘鱼册" FontFamily="Microsoft YaHei UI" FontSize="16" FontWeight="Bold" Foreground="#F3D99E"/>
                        <TextBlock Text="看看线索，等池塘来客慢慢现身" Margin="0,1,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#C6A779"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="收起" Margin="0,12,8,12" Padding="7,3" Background="#314B3D" Foreground="#F4DFAF" BorderBrush="#AE7A42" BorderThickness="1" FontFamily="Microsoft YaHei UI" FontSize="9" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
                <Grid Grid.Row="1" Margin="11,4,11,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CatchCountText" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="鱼册发现进度" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" FontWeight="Bold" Foreground="#46543B"/>
                        <TextBlock x:Name="StorageWarningText" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="鱼册存储警告" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#8B3328" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                    <ComboBox x:Name="FilterPicker" Grid.Column="1" Height="26" VerticalAlignment="Center" SelectionChanged="FilterPicker_SelectionChanged" FontFamily="Microsoft YaHei UI" FontSize="9" Background="#F1DEB8" Foreground="#35271E">
                        <ComboBoxItem Content="全部鱼种" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="尚未发现" Tag="undiscovered"/>
                        <ComboBoxItem Content="春季" Tag="spring"/><ComboBoxItem Content="夏季" Tag="summer"/>
                        <ComboBoxItem Content="秋季" Tag="autumn"/><ComboBoxItem Content="冬季" Tag="winter"/>
                        <ComboBoxItem Content="黎明" Tag="dawn"/><ComboBoxItem Content="白天" Tag="day"/>
                        <ComboBoxItem Content="黄昏" Tag="dusk"/><ComboBoxItem Content="夜晚" Tag="night"/>
                        <ComboBoxItem Content="限定事件" Tag="event"/>
                    </ComboBox>
                </Grid>
                <TabControl Grid.Row="2" Margin="10,0,10,5" Background="#CDB282" BorderBrush="#987449" FontFamily="Microsoft YaHei UI" FontSize="9">
                    <TabItem Header="探索图鉴">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#CDB282" Padding="8">
                            <ItemsControl ItemsSource="{Binding FishEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                            <Image Width="52" Height="38" Source="{Binding Sprite}" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,3,0" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="鱼类剪影或像素图"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FishName}" FontFamily="Microsoft YaHei UI" FontSize="11" FontWeight="Bold" Foreground="#354338"/>
                                                <TextBlock Text="{Binding MetaLabel}" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#896637"/>
                                                <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#625743" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StateLabel}" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#587249" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding CaughtAtLabel}" Margin="0,3,0,0" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#84765E" TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="最近收获">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#CDB282" Padding="8">
                            <ItemsControl ItemsSource="{Binding Catches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                            <Image Width="52" Height="38" Source="{Binding Sprite}" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,3,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FishName}" FontFamily="Microsoft YaHei UI" FontSize="11" FontWeight="Bold" Foreground="#354338"/>
                                                <TextBlock Text="{Binding MetaLabel}" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#896637"/>
                                                <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#625743" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TurnLabel}" Margin="0,3,0,0" FontFamily="Consolas" FontSize="8" Foreground="#84765E" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CaughtAtLabel}" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#84765E" TextAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Border Grid.Row="3" Margin="10,1,10,6" Padding="6,3" Background="#BBA077">
                    <TextBlock Text="事件鱼可以再次遇到；季节和时段只提供线索，不会因错过而失去鱼种。" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#443A2B" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
