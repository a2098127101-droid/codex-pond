<Window x:Class="CodexPond.FishBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鱼册"
        Width="380" Height="470"
        MinWidth="330" MinHeight="390"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        SnapsToDevicePixels="True">
    <Grid Margin="5">
        <Border Background="#211A18" BorderBrush="#805331" BorderThickness="2" Padding="3">
            <Grid Background="#DDC191">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="Auto" MinHeight="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#3B2922" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="鱼册" FontFamily="Microsoft YaHei UI" FontSize="16" FontWeight="Bold" Foreground="#F3D99E"/>
                        <TextBlock Text="完成的每一轮，都留下池塘来客" Margin="0,1,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#C6A779"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="收起" Margin="0,12,8,12" Padding="7,3" Background="#314B3D" Foreground="#F4DFAF" BorderBrush="#AE7A42" BorderThickness="1" FontFamily="Microsoft YaHei UI" FontSize="9" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
                <Grid Grid.Row="1" Margin="11,4,11,2">
                    <StackPanel>
                        <TextBlock x:Name="CatchCountText" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="鱼册收获条数" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="10" FontWeight="Bold" Foreground="#46543B"/>
                        <TextBlock x:Name="StorageWarningText" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="鱼册存储警告" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#8B3328" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="10,0,10,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#CDB282" Padding="9">
                        <ItemsControl ItemsSource="{Binding Catches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Width="52" Height="38" Source="{Binding Sprite}" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,3,0" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="{Binding FishName}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding FishName}" FontFamily="Microsoft YaHei UI" FontSize="11" FontWeight="Bold" Foreground="#354338"/>
                                            <TextBlock Text="{Binding MetaLabel}" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#896637"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#625743" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TurnLabel}" Margin="0,3,0,0" FontFamily="Consolas" FontSize="8" Foreground="#84765E" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CaughtAtLabel}" FontFamily="Microsoft YaHei UI" FontSize="8" Foreground="#84765E" TextAlignment="Right" VerticalAlignment="Top"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="鱼册还是空的。&#10;完成一轮 Agent 任务，或在独立模式钓鱼，第一条鱼就会来池塘报到。" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#6C674F" TextWrapping="Wrap" Margin="22" IsHitTestVisible="False"/>
                </Grid>
                <Border Grid.Row="3" Margin="10,1,10,6" Padding="6,3" Background="#BBA077">
                    <TextBlock Text="鱼获只保存在这台电脑的本地鱼册中。" FontFamily="Microsoft YaHei UI" FontSize="9" Foreground="#443A2B" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
